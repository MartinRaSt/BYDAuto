<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Typ nabíjení -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_charging_type"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Datum -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_date"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_today"
            app:endIconContentDescription="@string/action_set_today">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tachometr -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilOdometer"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_odometer">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOdometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Začátek -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStartTime"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_start_time"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_clock"
            app:endIconContentDescription="@string/action_set_now">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStartTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Konec -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEndTime"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_end_time"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_clock"
            app:endIconContentDescription="@string/action_set_now">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEndTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Doba trvání -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDuration"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_duration">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="time" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Výkon -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPower"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_power_kw">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Elektroměr auta na začátku -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStartMeter"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_start_meter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStartMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Elektroměr auta na konci -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEndMeter"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_end_meter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEndMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nabito kWh -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilChargedKwh"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_charged_kwh">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChargedKwh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Stav baterie na zacatku (%) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSocStart"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:suffixText="%"
            android:hint="@string/label_soc_start">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSocStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Stav baterie na konci (%) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSocEnd"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:suffixText="%"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_battery_full"
            app:endIconContentDescription="@string/action_set_full"
            android:hint="@string/label_soc_end">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSocEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Odvozene hodnoty (nabito do baterie, ucinnost, dojezd) - jen zobrazeni -->
        <TextView
            android:id="@+id/tvSocInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="4dp"
            android:textSize="12sp"
            android:visibility="gone"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Do baterie 8,1 kWh - ucinnost 87 %" />

        <!-- Hlavní elektroměr na začátku -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMainMeter"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_main_meter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMainMeter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hlavní elektroměr na konci -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMainMeterEnd"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_main_meter_end">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMainMeterEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Elektroměr garáže na začátku -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGarageMeterStart"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_garage_meter_start">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGarageMeterStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Elektroměr garáže na konci -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGarageMeterEnd"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_garage_meter_end">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGarageMeterEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Cena za kWh -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPricePerKwh"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_price_per_kwh">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPricePerKwh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Celková cena -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTotalPrice"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_total_price">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTotalPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Místo (jen PUBLIC + GARAGE) – tlačítko GPS načte souřadnice -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocation"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_location"
            android:visibility="gone"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_gps"
            app:endIconContentDescription="@string/gps_load_location">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textAutoCorrect" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Poznámka -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNote"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/label_note">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tlačítka -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/save" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
